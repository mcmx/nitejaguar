package web

templ CredentialsPage(data *CredentialsPageData) {
	@Base(data.CurrentUser) {
		<main class="container mx-auto max-w-6xl px-4 py-8" x-data="{ credType: 'generic', scope: 'tenant' }">
			<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="text-sm font-medium text-red-500">Nite Jaguar</p>
					<h1 class="text-3xl font-bold tracking-tight">Credentials</h1>
				</div>
			</div>
			<p class="mb-6 text-sm text-muted-foreground">Secrets are stored encrypted at rest and never displayed here — only metadata. Workflow nodes reference them by name or id via <code>credential_ref</code>; the executing client fetches the plaintext just-in-time. Name resolution is most-specific-wins: <code>user &gt; group &gt; tenant</code>.</p>
			if data.Error != "" {
				<p class="mb-6 rounded-lg border border-red-500/50 p-4 text-red-500">{ data.Error }</p>
			}
			if data.Success != "" {
				<p class="mb-6 rounded-lg border border-green-500/50 p-4 text-green-600">{ data.Success }</p>
			}
			if data.CurrentUser != nil && data.CurrentUser.IsOperator() {
				<form method="post" action="/credentials" class="mb-8 space-y-4 rounded-lg border border-border p-5">
					<h2 class="font-semibold">Store credential</h2>
					<div class="grid gap-4 md:grid-cols-2">
						<div>
							<label class="mb-1 block text-xs font-medium">Name</label>
							<input type="text" name="name" required placeholder="my-api-token" class="w-full rounded border border-border bg-background px-3 py-2 text-sm font-mono"/>
						</div>
						<div>
							<label class="mb-1 block text-xs font-medium">Type</label>
							<select name="type" x-model="credType" class="w-full rounded border border-border bg-background px-3 py-2 text-sm">
								for _, d := range data.Defs {
									<option value={ d.Name }>{ d.Label }</option>
								}
							</select>
							for _, d := range data.Defs {
								<p class="mt-1 text-xs text-muted-foreground" x-show={ "credType === '" + d.Name + "'" }>{ d.Description }</p>
							}
						</div>
						<div>
							<label class="mb-1 block text-xs font-medium">Scope</label>
							<select name="scope" x-model="scope" class="w-full rounded border border-border bg-background px-3 py-2 text-sm">
								<option value="tenant">tenant</option>
								<option value="group">group</option>
								<option value="user">user</option>
							</select>
						</div>
						<div x-show="scope === 'group' || scope === 'user'">
							<label class="mb-1 block text-xs font-medium">Owner ID (group name or user id)</label>
							<input type="text" name="owner_id" placeholder="ops (group) or user_... (user)" x-bind:disabled="scope === 'tenant'" x-bind:required="scope === 'group' || scope === 'user'" class="w-full rounded border border-border bg-background px-3 py-2 text-sm font-mono"/>
						</div>
					</div>
					for _, d := range data.Defs {
						<div class="grid gap-4 md:grid-cols-2" x-show={ "credType === '" + d.Name + "'" }>
							for _, f := range d.Fields {
								if f.Input == "textarea" {
									<div class="md:col-span-2">
										<label class="mb-1 block text-xs font-medium">
											{ f.Label }
											if !f.Required {
												<span class="font-normal text-muted-foreground">(optional)</span>
											}
										</label>
										<textarea
											name={ "secret_" + f.Name }
											rows="4"
											placeholder={ f.Placeholder }
											x-bind:disabled={ "credType !== '" + d.Name + "'" }
											if f.Required {
												required
											}
											class="w-full rounded border border-border bg-background px-3 py-2 font-mono text-sm"
										></textarea>
										if f.Help != "" {
											<p class="mt-1 text-xs text-muted-foreground">{ f.Help }</p>
										}
									</div>
								} else {
									<div>
										<label class="mb-1 block text-xs font-medium">
											{ f.Label }
											if !f.Required {
												<span class="font-normal text-muted-foreground">(optional)</span>
											}
										</label>
										if f.Input == "password" {
											<input
												type="password"
												name={ "secret_" + f.Name }
												placeholder={ f.Placeholder }
												autocomplete="new-password"
												x-bind:disabled={ "credType !== '" + d.Name + "'" }
												if f.Required {
													required
												}
												class="w-full rounded border border-border bg-background px-3 py-2 text-sm"
											/>
										} else {
											<input
												type="text"
												name={ "secret_" + f.Name }
												placeholder={ f.Placeholder }
												x-bind:disabled={ "credType !== '" + d.Name + "'" }
												if f.Required {
													required
												}
												class="w-full rounded border border-border bg-background px-3 py-2 text-sm font-mono"
											/>
										}
										if f.Help != "" {
											<p class="mt-1 text-xs text-muted-foreground">{ f.Help }</p>
										}
									</div>
								}
							}
						</div>
					}
					<div>
						<label class="mb-1 block text-xs font-medium">Description</label>
						<input type="text" name="description" placeholder="What is this credential for?" class="w-full rounded border border-border bg-background px-3 py-2 text-sm"/>
					</div>
					<button type="submit" class="rounded bg-red-500 px-4 py-2 text-sm font-medium text-white hover:bg-red-600">Store credential</button>
				</form>
			}
			if len(data.Credentials) == 0 {
				<p class="rounded-lg border border-border p-6">No credentials stored yet.</p>
			} else {
				<div class="grid gap-4 md:grid-cols-2">
					for _, c := range data.Credentials {
						<article class="rounded-lg border border-border p-5">
							<div class="flex items-start justify-between gap-4">
								<div><h2 class="font-semibold">{ c.Name }</h2><p class="mt-1 break-all font-mono text-xs text-muted-foreground">{ c.ID }</p></div>
								<span class="rounded-full bg-muted px-2 py-1 font-mono text-xs">{ c.Type }</span>
							</div>
							<div class="mt-4 grid gap-2 text-sm text-muted-foreground"><p><strong class="text-foreground">Tenant:</strong> { c.TenantID }</p><p><strong class="text-foreground">Scope:</strong> { c.Scope }</p><p><strong class="text-foreground">Owner:</strong> { c.OwnerID }</p><p><strong class="text-foreground">Description:</strong> { c.Description }</p><p><strong class="text-foreground">Created:</strong> { c.CreatedAt }</p></div>
							if data.CurrentUser != nil && data.CurrentUser.IsOperator() {
								<form method="post" action={ templ.URL("/credentials/" + c.ID + "/delete") } class="mt-4" onsubmit="return confirm('Delete credential { c.Name }? Nodes referencing it will fail to fetch.');"><button type="submit" class="rounded border border-border px-3 py-1 text-xs hover:border-red-500">Delete credential</button></form>
							}
						</article>
					}
				</div>
			}
		</main>
	}
}
