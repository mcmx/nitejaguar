package web

import "strings"

var calendarWeekdays = []string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}

func includesCalendarWeekday(weekdays []string, weekday string) bool {
	for _, day := range weekdays {
		if day == weekday {
			return true
		}
	}
	return false
}

templ BusinessCalendarsPage(data *BusinessCalendarsPageData) {
	@Base(data.CurrentUser) {
		<main class="container mx-auto max-w-6xl px-4 py-8">
			<div class="mb-8">
				<p class="text-sm font-medium text-red-500">Nite Jaguar</p>
				<h1 class="text-3xl font-bold tracking-tight">Business calendars</h1>
			</div>
			<p class="mb-6 text-sm text-muted-foreground">Manage reusable cron rules. Select weekdays to allow; listed dates are always excluded. Leave weekdays unselected to allow every day. Reference a calendar by name in a Cron trigger's <code>calendar</code> argument. Changes affect triggers the next time their workflow is loaded.</p>
			if data.Error != "" {
				<p class="mb-6 rounded-lg border border-red-500/50 p-4 text-red-500">{ data.Error }</p>
			}
			if data.Success != "" {
				<p class="mb-6 rounded-lg border border-green-500/50 p-4 text-green-600">{ data.Success }</p>
			}
			if data.CurrentUser != nil && data.CurrentUser.IsOperator() {
				<form method="post" action="/calendars" class="mb-8 space-y-4 rounded-lg border border-border p-5">
					<h2 class="font-semibold">Create calendar</h2>
					<div>
						<label class="mb-1 block text-xs font-medium">Name</label>
						<input type="text" name="name" required placeholder="us-business-days" class="w-full rounded border border-border bg-background px-3 py-2 text-sm font-mono"/>
					</div>
					<div>
						<p class="mb-2 text-xs font-medium">Allowed weekdays (optional)</p>
						<div class="flex flex-wrap gap-3">
							for _, day := range calendarWeekdays {
								<label class="flex items-center gap-2 text-sm">
									<input type="checkbox" name="weekdays" value={ day } class="rounded border-border"/>
									{ day }
								</label>
							}
						</div>
					</div>
					<div>
						<label class="mb-1 block text-xs font-medium">Excluded dates</label>
						<textarea name="excluded_dates" rows="4" placeholder="One YYYY-MM-DD date per line" class="w-full rounded border border-border bg-background px-3 py-2 font-mono text-sm"></textarea>
					</div>
					<button type="submit" class="rounded bg-red-500 px-4 py-2 text-sm font-medium text-white hover:bg-red-600">Create calendar</button>
				</form>
			}
			if len(data.Calendars) == 0 {
				<p class="rounded-lg border border-border p-6">No business calendars created yet.</p>
			} else {
				<div class="grid gap-4 md:grid-cols-2">
					for _, calendar := range data.Calendars {
						<article class="rounded-lg border border-border p-5">
							<h2 class="font-semibold">{ calendar.Name }</h2>
							<p class="mt-1 break-all font-mono text-xs text-muted-foreground">{ calendar.ID }</p>
							<p class="mt-2 text-xs text-muted-foreground">Tenant: { calendar.TenantID } · Updated: { calendar.UpdatedAt }</p>
							if data.CurrentUser != nil && data.CurrentUser.IsOperator() {
								<form method="post" action={ templ.URL("/calendars/" + calendar.ID + "/update") } class="mt-4 space-y-4 border-t border-border pt-4">
									<div>
										<label class="mb-1 block text-xs font-medium">Name</label>
										<input type="text" name="name" required value={ calendar.Name } class="w-full rounded border border-border bg-background px-3 py-2 text-sm font-mono"/>
									</div>
									<div>
										<p class="mb-2 text-xs font-medium">Allowed weekdays</p>
										<div class="flex flex-wrap gap-3">
											for _, day := range calendarWeekdays {
												<label class="flex items-center gap-2 text-sm">
													<input type="checkbox" name="weekdays" value={ day } checked={ includesCalendarWeekday(calendar.Weekdays, day) } class="rounded border-border"/>
													{ day }
												</label>
											}
										</div>
									</div>
									<div>
										<label class="mb-1 block text-xs font-medium">Excluded dates</label>
										<textarea name="excluded_dates" rows="4" class="w-full rounded border border-border bg-background px-3 py-2 font-mono text-sm">{ strings.Join(calendar.ExcludedDates, "\n") }</textarea>
									</div>
									<button type="submit" class="rounded border border-border px-3 py-1.5 text-sm hover:border-red-500">Save changes</button>
								</form>
								<form method="post" action={ templ.URL("/calendars/" + calendar.ID + "/delete") } class="mt-3" onsubmit="return confirm('Delete this calendar? Cron triggers referencing it will stop resolving on their next load.');">
									<button type="submit" class="rounded border border-border px-3 py-1.5 text-xs hover:border-red-500">Delete calendar</button>
								</form>
							} else {
								<div class="mt-4 space-y-2 text-sm text-muted-foreground">
									<p><strong class="text-foreground">Allowed weekdays:</strong> { strings.Join(calendar.Weekdays, ", ") }</p>
									<p><strong class="text-foreground">Excluded dates:</strong> { strings.Join(calendar.ExcludedDates, ", ") }</p>
								</div>
							}
						</article>
					}
				</div>
			}
		</main>
	}
}
