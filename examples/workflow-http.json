{
    "id": "workflow_http_example",
    "name": "Example Workflow: call an outbound webhook on failure",
    "nodes": {
      "trigger_01hhttp00000000000001": {
        "id": "trigger_01hhttp00000000000001",
        "name": "Trigger: filechange",
        "description": "Trigger: on /tmp",
        "action_type": "trigger",
        "action_name": "filechange",
        "arguments": {
          "path": "/tmp",
          "event_type": "create"
        },
        "conditions": {
          "entries": {
            "entry1": {
                "condition": {
                    "leftOperand": true,
                    "operator": "",
                    "rightOperand": null
                },
                "nexts": ["action_01hhttp00000000000001"]
            }
          }
        },
        "dependencies": null
      },
      "action_01hhttp00000000000001": {
        "id": "action_01hhttp00000000000001",
        "name": "Action: file",
        "description": "Action: archive the new file (may fail)",
        "action_type": "action",
        "action_name": "file",
        "arguments": {
          "action": "copy",
          "file": "$input.file",
          "destination": "/var/backups/$input.name"
        },
        "conditions": {
          "entries": {
            "on_error": {
                "condition": {
                    "leftOperand": "$result.type",
                    "operator": "==",
                    "rightOperand": "error"
                },
                "nexts": ["action_01hhttp00000000000002"]
            }
          }
        },
        "dependencies": ["trigger_01hhttp00000000000001"]
      },
      "action_01hhttp00000000000002": {
        "id": "action_01hhttp00000000000002",
        "name": "Alert: webhook",
        "description": "Alert: POST the failure to the ops webhook",
        "action_type": "action",
        "action_name": "http",
        "credential_ref": "ops-webhook-token",
        "arguments": {
          "url": "https://ops.example.com/hooks/deploy-failures",
          "method": "POST",
          "auth": "bearer",
          "headers": "{\"X-Alert-Source\": \"nitejaguar\"}",
          "body": "{\"severity\": \"error\", \"file\": \"$input.file\", \"error\": \"$input.result\"}"
        },
        "conditions": {
          "entries": {}
        },
        "dependencies": ["action_01hhttp00000000000001"]
      }
  }
}
