{
    "id": "workflow_slack_example",
    "name": "Example Workflow: alert Slack on failure",
    "nodes": {
      "trigger_01hslack000000000001": {
        "id": "trigger_01hslack000000000001",
        "name": "Trigger: filechange",
        "description": "Trigger: on /tmp",
        "action_type": "trigger",
        "action_name": "filechange",
        "arguments": {
          "path": "/tmp",
          "event_type": "create"
        },
        "conditions": {
          "entries": {
            "entry1": {
                "condition": {
                    "leftOperand": true,
                    "operator": "",
                    "rightOperand": null
                },
                "nexts": ["action_01hslack000000000001"]
            }
          }
        },
        "dependencies": null
      },
      "action_01hslack000000000001": {
        "id": "action_01hslack000000000001",
        "name": "Action: file",
        "description": "Action: archive the new file (may fail)",
        "action_type": "action",
        "action_name": "file",
        "arguments": {
          "action": "copy",
          "file": "$input.file",
          "destination": "/var/backups/$input.name"
        },
        "conditions": {
          "entries": {
            "on_error": {
                "condition": {
                    "leftOperand": "$result.type",
                    "operator": "==",
                    "rightOperand": "error"
                },
                "nexts": ["action_01hslack000000000002"]
            }
          }
        },
        "dependencies": ["trigger_01hslack000000000001"]
      },
      "action_01hslack000000000002": {
        "id": "action_01hslack000000000002",
        "name": "Alert: slack",
        "description": "Alert: notify #alerts when the archive step fails",
        "action_type": "action",
        "action_name": "slack",
        "credential_ref": "slack-alerts-webhook",
        "arguments": {
          "text": ":rotating_light: Archive failed for $input.file: $input.result",
          "channel": "#alerts",
          "username": "nitejaguar"
        },
        "conditions": {
          "entries": {}
        },
        "dependencies": ["action_01hslack000000000001"]
      }
  }
}
